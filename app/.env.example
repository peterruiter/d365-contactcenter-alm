# Which data source the app uses.
#   mock       in-memory sample data. No backend. Runs standalone. (default)
#   backend    direct HTTP to the deployed Function. Local dev only (needs CORS on the Function).
#   connector  through the custom connector. The path the published-in-Dynamics app uses.
#   local      the local runner (scripts/run-local.ps1). Set by .env.runner; no need to set it here.
VITE_ALM_SOURCE=mock

# Only for VITE_ALM_SOURCE=backend. The base URL of the deployed Function, e.g.
# https://ccalmfuncYOURINITIALS.azurewebsites.net/api
VITE_ALM_BACKEND_URL=

# Visual identity: logo, colors, page title. See app/src/brands/.
#   powerpete   Power Pete purple/lilac palette and wordmark. (default - unset falls back to this)
#   capgemini   Capgemini Zodiak blue palette and logo.
VITE_BRAND=powerpete
