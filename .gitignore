# Node / app build
app/node_modules/
app/dist/
app/dist-runner/

# Local runner exe build (scripts/build-runner-release.ps1)
runner-exe/bin/
runner-exe/obj/
runner-exe/payload/
node_modules/

# Environment registry with real URLs and any secret. Never commit.
environments.json
*.local.json
.env
.env.local

# Code app generated config that carries environment/connection ids specific to one org
# (regenerate with pac code init + pac code add-data-source). Comment these out if you want to
# commit your own fork's power.config.json.
app/power.config.json
app/.power/
app/src/generated/

# Run output from the reference engine
out/
*.snapshot.json

# Secrets
*.secret

# Editor / OS noise
*.log
.vs/

*.user
.DS_Store

# Registry copy shipped into the function app at deploy
backend/function-app/environments.json

# Recorded test fixtures hold real configuration from real environments (scripts/record-fixture.ps1).
tests/fixtures/recorded/

# XrmToolBox tool build output
xrmtoolbox/**/bin/
xrmtoolbox/**/obj/
xrmtoolbox/obj/
