<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The local runner as one self-contained exe: the .NET runtime, the PowerShell 7 engine and the
    runner (scripts, engine module, built app) in a single file, so a laptop needs neither
    PowerShell 7 nor Node.js. Built by scripts/build-runner-release.ps1, which puts the runner
    files in payload/payload.zip first.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The runtime baked into the exe; keep it on the latest .NET 10 security patch rather than
         whatever the build machine's SDK happens to carry. -->
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The PowerShell SDK finds its own files by assembly location, which a single-file bundle
         does not have unless everything is extracted on first start. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ContactCenterALM-LocalRunner</AssemblyName>
    <RootNamespace>CcAlmRunner</RootNamespace>

    <!-- The icon and what Windows shows under Properties > Details, so the exe says what it is and
         who wrote it. The release script overrides the versions with the build's own identity. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyTitle>Contact Center ALM local runner</AssemblyTitle>
    <Product>Contact Center ALM</Product>
    <Authors>Peter Ruiter</Authors>
    <Company>Peter Ruiter</Company>
    <Copyright>Copyright © 2026 Peter Ruiter. MIT licence.</Copyright>
    <Description>Compares and moves Dynamics 365 Contact Center configuration between environments: workstreams with their routing, queues, rulesets, templates and channels. Written by Peter Ruiter - https://github.com/peterruiter/d365-contactcenter-alm</Description>
    <Version>0.3.0</Version>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <!-- Keep the product version readable: the SDK otherwise appends the full commit sha to it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
    <!-- The SDK pulls in 10.0.10 of these, which carry the October 2026 security advisories
         (GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6 and others). 10.0.13 is the fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload/payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
